# ===== owlleak 환경변수 예시 (security-fixes 패치) =====
# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요. .env는 절대 커밋하지 마세요.

# --- 데이터베이스 (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:[비밀번호]@[호스트]:5432/postgres
DIRECT_URL=postgresql://postgres:[비밀번호]@[호스트]:5432/postgres

# --- 인증 (필수) ---
# 64자 랜덤 문자열 권장. 예: openssl rand -hex 64
JWT_SECRET=
# 레거시 비밀번호 전용 관리자 로그인용. 미설정 시 해당 로그인 방식 비활성화.
ADMIN_PASSWORD=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 앱 URL ---
NEXT_PUBLIC_APP_URL=https://www.owl-leak.kr

# --- 카카오 알림톡 (Solapi) ---
# test = 발송 시뮬레이션(DB 기록만), real = 실제 발송
ALIMTALK_MODE=test
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PFID=
SOLAPI_SENDER_PHONE=
SOLAPI_TEMPLATE_ESTIMATE=
SOLAPI_TEMPLATE_EMERGENCY=
SOLAPI_TEMPLATE_COMPLETED=
SOLAPI_TEMPLATE_SETTLEMENT=

# --- 구독 만료 스윕 크론 (Vercel Cron 인증용, 임의의 긴 랜덤 문자열) ---
CRON_SECRET=

# --- AI 진단 (Gemini 비전) ---
GEMINI_API_KEY=
# 선택: 사용할 비전 모델 (기본 gemini-2.5-flash)
GEMINI_VISION_MODEL=
